    "code": "CREATE VIEW candidate.report AS SELECT COALESCE(building, 'Unknown') AS building, COUNT(*) AS total_tickets, COUNT(*) FILTER (WHERE LOWER(BTRIM(status)) IN ('resolved', 'closed')) AS terminal_tickets, COUNT(*) FILTER (WHERE LOWER(BTRIM(status)) IN ('open', 'in progress', 'pending vendor', 'escalated')) AS unresolved_tickets, COUNT(*) FILTER (WHERE status IS NULL OR LOWER(BTRIM(status)) IN ('', 'null', 'unknown', '???') OR LOWER(BTRIM(status)) NOT IN ('open', 'in progress', 'pending vendor', 'escalated', 'resolved', 'closed')) AS unknown_status_tickets, COUNT(*) FILTER (WHERE LOWER(BTRIM(priority)) = 'critical' AND LOWER(BTRIM(status)) IN ('open', 'in progress', 'pending vendor', 'escalated')) AS critical_unresolved_tickets, COUNT(*) FILTER (WHERE cost >= 0) AS tickets_with_recorded_cost, SUM(cost) FILTER (WHERE cost >= 0) AS total_recorded_cost, AVG(cost) FILTER (WHERE cost >= 0) AS average_recorded_cost, 100.0 * COUNT(*) FILTER (WHERE cost >= 0) / NULLIF(COUNT(*), 0) AS cost_coverage_pct, 100.0 * COUNT(*) FILTER (WHERE LOWER(BTRIM(status)) IN ('resolved', 'closed')) / NULLIF(COUNT(*) FILTER (WHERE LOWER(BTRIM(status)) IN ('open', 'in progress', 'pending vendor', 'escalated', 'resolved', 'closed')), 0) AS terminal_rate_pct FROM silver.tickets GROUP BY COALESCE(building, 'Unknown')",
